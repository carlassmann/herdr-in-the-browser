{
  "name": "herdr-terminal",
  "version": "0.1.0",
  "description": "A web terminal for Herdr that mirrors your Ghostty configuration, reachable through a Cloudflare Tunnel.",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --hot src/server/index.ts",
    "build": "bun build --target=bun --production --outdir=dist src/server/index.ts",
    "check": "bun run format:check && bun run typecheck && bun test && bun run build",
    "format": "prettier --write README.md 'docs/**/*.md' package.json work.config.js public/sw.js 'src/**/*.{ts,css,html}' '.github/**/*.yml'",
    "format:check": "prettier --check README.md 'docs/**/*.md' package.json work.config.js public/sw.js 'src/**/*.{ts,css,html}' '.github/**/*.yml'",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "bun-pty": "^0.4.10",
    "ghostty-web": "^0.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.0"
  },
  "patchedDependencies": {
    "ghostty-web@0.4.0": "patches/ghostty-web@0.4.0.patch"
  }
}
