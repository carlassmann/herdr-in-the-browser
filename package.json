{
  "name": "herdr-web-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --hot src/server/index.ts",
    "build": "bun build --target=bun --production --outdir=dist src/server/index.ts",
    "check": "bun run typecheck && bun test && bun run build",
    "format": "prettier --write .",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@heroicons/react": "^2.2.0",
    "bun-pty": "^0.4.10",
    "ghostty-web": "^0.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.0"
  },
  "patchedDependencies": {
    "ghostty-web@0.4.0": "patches/ghostty-web@0.4.0.patch"
  }
}
